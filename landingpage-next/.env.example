# ==============================================================================
# Environment Variables Example
# ==============================================================================
# Salin file ini menjadi .env.local untuk penggunaan lokal:
# cp .env.example .env.local
# ==============================================================================

# URL Halaman Login (digunakan pada tombol Login di Navbar)
# Default jika tidak diisi: /login
NEXT_PUBLIC_LOGIN_URL=/login

# URL Utama Website (opsional untuk deployment / canonical URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
